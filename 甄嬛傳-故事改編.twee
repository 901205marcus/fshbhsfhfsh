        object-fit: cover;
        position:absolute;
        top:0;
        left:0;
    ">

    <!-- 遮罩 -->
    <div style="
        position:absolute;
        width:100%;
        height:100%;
        background:rgba(0,0,0,0.4);
    "></div>

    <!-- 花瓣 -->
