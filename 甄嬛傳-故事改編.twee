:: StoryScript [script]
setup.playBGM = function (src) {

    // ⭐ 無論如何先停掉舊的
    if (window.bgm) {
        window.bgm.pause();
        window.bgm.currentTime = 0;
        window.bgm = null;
    }

    // ⭐ 建立新的音樂
    window.bgm = new Audio(src);
    window.bgm.loop = true;
    window.bgm.volume = 0.5;

    const p = window.bgm.play();
    if (p !== undefined) {
        p.catch(err => console.log("播放失敗：", err));
    }
};

setup.stopBGM = function () {
    if (window.bgm) {
        window.bgm.pause();
        window.bgm = null;
    }
};

:: StoryStylesheet [stylesheet]
.petals {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
}

.petal {
    position: absolute;
    top: -60px;
    font-size: 20px;
    opacity: 0.75;
    animation-name: sakuraFall;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}

@keyframes sakuraFall {
    0% {
        transform: translateY(-60px) translateX(0px) rotate(0deg);
        opacity: 0;
    }
    10% {
        opacity: 0.8;
    }
    25% {
        transform: translateY(25vh) translateX(30px) rotate(90deg);
    }
    50% {
        transform: translateY(50vh) translateX(-20px) rotate(180deg);
    }
    75% {
        transform: translateY(75vh) translateX(35px) rotate(270deg);
    }
    100% {
        transform: translateY(110vh) translateX(-15px) rotate(360deg);
        opacity: 0.2;
    }
}



.scene-bg {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    color: white;
    font-family: "Noto Serif TC", serif;
}

.scene-bg img.bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.scene-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.40);
}

.characters {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.char {
    position: absolute;
    bottom: 0;
    width: 30%;
    max-height: 88%;
    object-fit: contain;
    transition: all 0.35s ease;
    opacity: 0.35;
    filter: brightness(0.68);
    transform: scale(0.96);
}

.char.left {
    left: 2%;
}

.char.right {
    right: 2%;
}

.char.active {
    opacity: 1;
    filter: brightness(1.05) drop-shadow(0 0 18px rgba(255,255,255,0.18));
    transform: scale(1.03);
}

.nameplate {
    position: absolute;
    top: -16px;
    right: 16px;
    padding: 4px 14px;
    background: rgba(20,20,20,0.85);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 8px;
    font-size: 20px;
    letter-spacing: 2px;
}

.dialogue-box {
    position: absolute;
    top: 35%;                
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;             
    min-height: 110px;
    padding: 5px 10px;
    background: rgba(10,10,10,0.55);
    border: 1px solid rgba(255,255,255,0.20);
    border-radius: 16px;
    box-shadow: 0 0 20px rgba(0,0,0,0.4);
    z-index: 5;
}
.dialogue-text {
    font-size: 24px;
    line-height: 1.8;
    text-shadow: 0 0 6px black;
}

.next-btn-wrap {
    position: absolute;
    right: 7%;
    bottom: 8%;
    z-index: 7;
}

.choice-wrap {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0%;
    width: 82%;
    z-index: 8;
    text-align: center;
}

.choice-title {
    margin-bottom: 150px;
    font-size: 24px;
    text-shadow: 0 0 6px black;
}

.choice-btn {
    display: block;
    width: 80%;                 /* ⭐ 控制寬度 */
    margin: 0px auto;           /* ⭐ 控制間距（越小越靠近） */
    padding: 5px 10px;         /* ⭐ 控制厚度 */
    background: rgba(0,0,0,0.55);
    color: white;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 10px;
    font-size: 24px;
    cursor: pointer;
    text-shadow: 0 0 6px black;
    transition: all 0.25s ease;
}

.choice-btn:hover {
    background: rgba(255,255,255,0.25);
    transform: scale(1.03);
}
.scene-title {
    position: absolute;
    top: 7%;
    width: 100%;
    text-align: center;
    font-size: 38px;
    letter-spacing: 4px;
    text-shadow: 0 0 8px black, 0 0 18px black;
    z-index: 5;
}