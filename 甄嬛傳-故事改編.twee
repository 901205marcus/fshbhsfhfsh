:: scene3_A {"position":"200,350","size":"100,100"}


<div class="scene-bg">

    <img class="bg" src="https://raw.githubusercontent.com/901205marcus/Hsvbsh/main/IMG_3728.jpeg">

    <div class="scene-overlay"></div>

    <div class="scene-title">選擇結果</div>

